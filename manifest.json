{
  "manifest_version": 3,
  "name": "Knowledge Graph Live",
  "version": "1.0.0",
  "description": "Open a Graphify-compatible knowledge graph and highlight nodes referenced by assistant answers.",
  "permissions": [],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.js", "graph.json"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
